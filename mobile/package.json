{
  "name": "baladiguard-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:routes": "node scripts/check-expo-router-files.js",
    "check:config": "node scripts/check-expo-config.js",
    "check:release": "node scripts/check-release-ready.js",
    "build:preview": "eas build --profile preview --platform android",
    "build:production": "eas build --profile production --platform android",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node ../scripts/check-i18n.mjs src/i18n/locales && node ../scripts/check-hardcoded-ui.mjs .",
    "test": "npm run check:i18n && vitest run"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.7.1",
    "babel-preset-expo": "~57.0.6",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "libphonenumber-js": "^1.13.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.3",
    "react-native-maps": "1.29.0",
    "react-native-paper": "^5.13.1",
    "react-native-safe-area-context": "~5.8.1",
    "react-native-screens": "~4.27.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expo-doctor": "^1.20.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.8",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "react",
        "react-dom",
        "react-native-maps",
        "react-native-safe-area-context",
        "react-native-screens"
      ]
    }
  },
  "private": true
}
