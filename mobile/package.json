{
  "name": "baladiguard-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check:routes": "node scripts/check-expo-router-files.js",
    "check:config": "node scripts/check-expo-config.js",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node ../scripts/check-i18n.mjs src/i18n/locales && node ../scripts/check-hardcoded-ui.mjs .",
    "test": "npm run check:i18n && vitest run"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "babel-preset-expo": "~58.0.13",
    "expo": "^58.0.9",
    "expo-asset": "~58.0.14",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.11",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.12",
    "expo-location": "~58.0.15",
    "expo-notifications": "~58.1.3",
    "expo-router": "~58.0.18",
    "expo-secure-store": "^58.0.2",
    "expo-status-bar": "~58.0.3",
    "libphonenumber-js": "^1.13.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-native": "0.87.1",
    "react-native-maps": "1.29.11",
    "react-native-paper": "^5.13.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.8",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "private": true
}
