EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# Normal local setup talks to the real backend API.
# Set EXPO_PUBLIC_ENABLE_MOCK_API=true only when intentionally testing mock submissions.
EXPO_PUBLIC_ENABLE_MOCK_API=false

EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Real end-to-end submission checklist:
# 1. Keep EXPO_PUBLIC_ENABLE_MOCK_API=false
# 2. Start the backend API (see README Backend section)
# 3. Configure backend/.env for DynamoDB + S3 (local Docker or cloud AWS)
# 4. Set AWS S3 env vars for photo uploads (AWS_REGION, AWS_S3_BUCKET, credentials)
# 5. Optional for live geocoding: LOCATION_PLACE_INDEX_NAME=<Amazon Location place index>
#    Leave unset to use the backend local Beirut place index.
# 6. Point EXPO_PUBLIC_API_BASE_URL at the running API
#    (http://localhost:8000/v1 for emulators; use your machine IP for a physical device)
