EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# Mock mode (default): returns a sample ticket without calling the backend.
# Real submission: set to false and complete the backend setup below.
EXPO_PUBLIC_ENABLE_MOCK_API=true

EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Real end-to-end submission checklist:
# 1. Set EXPO_PUBLIC_ENABLE_MOCK_API=false
# 2. Start the backend API (see README Backend section)
# 3. Configure backend/.env with DATABASE_BACKEND and DynamoDB (or memory for quick tests)
# 4. Set AWS S3 env vars in backend/.env for photo uploads (AWS_REGION, AWS_S3_BUCKET, credentials)
# 5. Point EXPO_PUBLIC_API_BASE_URL at the running API (use your machine IP for a physical device)
