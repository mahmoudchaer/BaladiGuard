{
  "comment": "Citizen-web CloudFront SPA hosting for issue #265. Pair with public/_headers.",
  "aliases": ["citizen.example"],
  "viewerProtocolPolicy": "redirect-to-https",
  "defaultRootObject": "index.html",
  "customErrorResponses": [
    {
      "errorCode": 403,
      "responseCode": 200,
      "responsePagePath": "/index.html",
      "errorCachingMinTTL": 0
    },
    {
      "errorCode": 404,
      "responseCode": 200,
      "responsePagePath": "/index.html",
      "errorCachingMinTTL": 0
    }
  ],
  "cacheBehaviors": [
    {
      "pathPattern": "/index.html",
      "cachePolicy": "Managed-CachingDisabled",
      "responseHeadersPolicy": "citizen-web-security-headers",
      "compress": true
    },
    {
      "pathPattern": "/t/*",
      "cachePolicy": "Managed-CachingDisabled",
      "responseHeadersPolicy": "citizen-web-security-headers",
      "compress": true
    },
    {
      "pathPattern": "/assets/*",
      "cachePolicy": "Managed-CachingOptimized",
      "cacheControl": "public, max-age=31536000, immutable",
      "compress": true
    }
  ],
  "doNotCache": [
    "/v1/citizen/*",
    "Set-Cookie",
    "authenticated API responses — configure on the API origin, not this SPA distribution"
  ]
}
