# Normal local setup talks to the backend API on port 8000.
# Staging/production builds must set VITE_APP_ENV + https VITE_API_BASE_URL.
# VITE_USE_MOCK_DATA is local/dev only — rejected in staging/production.
# See docs/configuration.md
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_DATA=false

# Firebase Phone Auth (public web-app configuration, never a server credential).
# Set all values shown in Firebase Console → Project settings → Your apps.
VITE_CITIZEN_OTP_DELIVERY_CHANNEL=mock
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
