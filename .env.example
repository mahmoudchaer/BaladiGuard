# Shared AWS values (optional). Backend also reads backend/.env.
# For cloud setup details see docs/cloud-setup.md
DATABASE_BACKEND=dynamodb
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Leave empty for real AWS DynamoDB. Use http://localhost:8001 for Docker local only.
DYNAMODB_ENDPOINT_URL=

DYNAMODB_TABLE_PREFIX=baladiguard-
SEED_SAMPLE_TICKETS=false
SECRET_KEY=
