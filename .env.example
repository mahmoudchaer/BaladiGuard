# Shared cloud AWS values. Backend loads backend/.env first, then this root .env
# (root wins on duplicate keys). See docs/cloud-setup.md and docs/configuration.md
#
# Never commit real secrets. Copy this file to .env and fill in team credentials.

# local | development | test | production (issue #147)
APP_ENV=local

DATABASE_BACKEND=dynamodb
AWS_REGION=us-east-1
AWS_S3_BUCKET=
IMAGE_REDACTION_ENABLED=true
REKOGNITION_PLATE_MODEL_ARN=
S3_PRESIGNED_URL_TTL_SECONDS=300
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Empty = real AWS DynamoDB. Use http://localhost:8001 only for Docker DynamoDB Local.
DYNAMODB_ENDPOINT_URL=

DYNAMODB_TABLE_PREFIX=baladiguard-
SEED_SAMPLE_TICKETS=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AI_JOB_MAX_ATTEMPTS=5
AI_JOB_TIMEOUT_SECONDS=300
AI_JOB_BACKOFF_BASE_SECONDS=5
AI_JOB_BACKOFF_MAX_SECONDS=300
AI_JOB_POLL_SECONDS=1
CLASSIFICATION_EVAL_S3_PREFIX=classification-eval/
CLASSIFICATION_EVAL_S3_BUCKET=

# Nearby duplicate detection (issue #25).
DUPLICATE_DISTANCE_THRESHOLD_M=100
DUPLICATE_MIN_SCORE=0.4
DUPLICATE_SAME_CATEGORY_WEIGHT=1.0
DUPLICATE_SIMILAR_CATEGORY_WEIGHT=0.7

# Notification delivery (issues #39 / #183): mock = log-only; real = SES + SNS.
# Production: NOTIFICATION_ADAPTER=real and SES_FROM_EMAIL (see docs/notifications.md).
NOTIFICATION_ADAPTER=mock
# SES_FROM_EMAIL=
# NOTIFICATION_SANDBOX=
# NOTIFICATION_ALLOWLIST_EMAILS=
# NOTIFICATION_ALLOWLIST_PHONES=

# Unsafe local-only OTP helper — see docs/configuration.md. Never enable outside local/dev.
# OTP_DEV_PLAINTEXT_STDOUT=false

# Amazon Location Service place index for geocoding (issue #24).
# Leave empty to use the curated local Beirut place index for CI/local development.
LOCATION_PLACE_INDEX_NAME=

# Staff API auth (issue #72). Defaults match the admin Vite demo credentials.
# SECRET_KEY is required (non-placeholder) when APP_ENV=production.
# Rotate SECRET_KEY and STAFF_PASSWORD before any shared/staging/production deployment.
SECRET_KEY=
STAFF_USERNAME=staff
STAFF_PASSWORD=staff-demo-password
STAFF_TOKEN_TTL_SECONDS=43200

LOG_LEVEL=INFO
