# Normal local setup talks to the backend API.
# Set VITE_USE_MOCK_DATA=true only when intentionally testing mock fixtures.
# See docs/configuration.md — demo staff credentials are for local development only.
VITE_APP_ENV=local
VITE_USE_MOCK_DATA=false
VITE_API_BASE_URL=http://localhost:8000
VITE_STAFF_USERNAME=staff
VITE_STAFF_PASSWORD=staff-demo-password
