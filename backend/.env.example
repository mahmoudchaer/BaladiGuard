# Cloud AWS defaults for issue #115 / production-like local runs.
# Copy to backend/.env and fill in real AWS credentials (or keep them in the repo-root .env).
# See docs/cloud-setup.md and docs/configuration.md (authoritative env catalog, issue #147).
#
# For Docker DynamoDB Local instead, see the "Local Docker override" section at the bottom.

# local | development | test | production
APP_ENV=local

DATABASE_BACKEND=dynamodb
AWS_REGION=us-east-1
DYNAMODB_TABLE_PREFIX=baladiguard-
SEED_SAMPLE_TICKETS=false

# Empty = real AWS DynamoDB. Do not set localhost:8001 for cloud mode.
DYNAMODB_ENDPOINT_URL=

# Required for real photo uploads to S3 (required in production).
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon Bedrock multimodal classification (issue #17).
# Enable model access in the Bedrock console for your account/region first.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# How long a processing AI claim may sit before startup recovery can reclaim it.
# Fresh claims are left alone so rolling deploys / multi-worker startups do not
# steal work another worker is still handling.
AI_PROCESSING_CLAIM_TIMEOUT_SECONDS=300

# Nearby duplicate detection (issue #25). Threshold is meters; score is 0..1.
DUPLICATE_DISTANCE_THRESHOLD_M=100
DUPLICATE_MIN_SCORE=0.4
DUPLICATE_SAME_CATEGORY_WEIGHT=1.0
DUPLICATE_SIMILAR_CATEGORY_WEIGHT=0.7

# Notification delivery (issue #39): mock = log-only; real = provider path (not configured yet).
# Production must use NOTIFICATION_ADAPTER=real.
NOTIFICATION_ADAPTER=mock

# Amazon Location Service place index for geocoding (issue #24).
# Leave empty to use the curated local Beirut place index for CI/local development.
# Production requires a real place index name.
LOCATION_PLACE_INDEX_NAME=

# Optional manual classification eval (not used by CI).
# Image binaries stay outside the repo; the manifest only stores refs.
# Defaults: bucket=AWS_S3_BUCKET, prefix=classification-eval/
CLASSIFICATION_EVAL_S3_PREFIX=classification-eval/
CLASSIFICATION_EVAL_S3_BUCKET=
# Optional HTTPS base if imageRef values are served over HTTP instead of S3:
# CLASSIFICATION_EVAL_IMAGE_BASE_URL=https://example.com/eval-images/

OPENAI_API_KEY=
# Required (non-placeholder) when APP_ENV=production. Never commit real secrets.
SECRET_KEY=

LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Local Docker override (optional development only)
# -----------------------------------------------------------------------------
# DATABASE_BACKEND=dynamodb
# DYNAMODB_ENDPOINT_URL=http://localhost:8001
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
# AWS_S3_BUCKET=   # still need real S3 credentials/bucket for photo uploads
