# Default for local tests / quick starts. For cloud AWS DynamoDB, use:
#   DATABASE_BACKEND=dynamodb
#   DYNAMODB_ENDPOINT_URL=
# See docs/cloud-setup.md
DATABASE_BACKEND=memory
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Local Docker DynamoDB. Leave empty for real AWS DynamoDB.
DYNAMODB_ENDPOINT_URL=http://localhost:8001

DYNAMODB_TABLE_PREFIX=baladiguard-
SEED_SAMPLE_TICKETS=false
OPENAI_API_KEY=
SECRET_KEY=

# Required for real photo uploads (local or cloud).
AWS_S3_BUCKET=
