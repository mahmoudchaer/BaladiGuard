# Cloud AWS defaults for issue #115 / production-like local runs.
# Copy to backend/.env and fill in real AWS credentials (or keep them in the repo-root .env).
# See docs/cloud-setup.md and docs/configuration.md (authoritative env catalog, issue #147).
#
# For Docker DynamoDB Local instead, see the "Local Docker override" section at the bottom.

# local | development | test | production
APP_ENV=local

DATABASE_BACKEND=dynamodb
AWS_REGION=us-east-1
DYNAMODB_TABLE_PREFIX=baladiguard-
SEED_SAMPLE_TICKETS=false
# Keep false until timeline GSIs are ACTIVE and backfill_activity_timeline_keys.py has finished.
ACTIVITY_TIMELINE_USE_GSI=false

# Empty = real AWS DynamoDB. Do not set localhost:8001 for cloud mode.
DYNAMODB_ENDPOINT_URL=

# Required for real photo uploads to S3 (required in production).
AWS_S3_BUCKET=
IMAGE_REDACTION_ENABLED=true
IMAGE_REDACTION_DETECTOR=aws_rekognition
# Built-in model name for development, or a local ONNX path in production.
PLATE_DETECTION_MODEL=yolo-v9-s-608-license-plate-end2end
IMAGE_REDACTION_AUTO_CONFIDENCE=90
IMAGE_REDACTION_REVIEW_CONFIDENCE=60
IMAGE_REDACTION_BLUR_RADIUS=18
IMAGE_REDACTION_BOX_PADDING=0.08
IMAGE_REDACTION_JOB_MAX_ATTEMPTS=5
IMAGE_REDACTION_JOB_TIMEOUT_SECONDS=300
IMAGE_REDACTION_JOB_BACKOFF_BASE_SECONDS=5
IMAGE_REDACTION_JOB_BACKOFF_MAX_SECONDS=300
S3_PRESIGNED_URL_TTL_SECONDS=300
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon Bedrock multimodal classification (issue #17).
# Enable model access in the Bedrock console for your account/region first.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Ticket content safety and authenticity screening (issue #319).
CONTENT_SAFETY_ENABLED=true
# Unset = fail-closed outside local/test/development.
CONTENT_SAFETY_FAIL_CLOSED=
CONTENT_SAFETY_TEXT_MODEL_ID=amazon.nova-lite-v1:0
CONTENT_SAFETY_IMAGE_REJECT_CONFIDENCE=80
CONTENT_SAFETY_IMAGE_REVIEW_CONFIDENCE=50
CONTENT_SAFETY_AUTHENTICITY_REVIEW_SCORE=0.85
# Empty uses the pinned DeepfakeDet ONNX (Docker / backend/models/). Run
# `make download-authenticity-model` for a local worker.
AUTHENTICITY_DETECTION_MODEL=
CONTENT_SAFETY_JOB_MAX_ATTEMPTS=5
CONTENT_SAFETY_JOB_TIMEOUT_SECONDS=300
CONTENT_SAFETY_JOB_BACKOFF_BASE_SECONDS=5
CONTENT_SAFETY_JOB_BACKOFF_MAX_SECONDS=300

# Multi-municipality routing (issue #322). Model disambiguation is off in CI.
MUNICIPALITY_ROUTING_ENABLED=true
MUNICIPALITY_ROUTING_USE_MODEL=false
MUNICIPALITY_ROUTING_MODEL_ID=amazon.nova-lite-v1:0
MUNICIPALITY_ROUTING_HIGH_CONFIDENCE=0.85

# How long a processing AI claim may sit before startup recovery can reclaim it.
# Fresh claims are left alone so rolling deploys / multi-worker startups do not
# steal work another worker is still handling.
AI_PROCESSING_CLAIM_TIMEOUT_SECONDS=300
AI_JOB_MAX_ATTEMPTS=5
AI_JOB_TIMEOUT_SECONDS=300
AI_JOB_BACKOFF_BASE_SECONDS=5
AI_JOB_BACKOFF_MAX_SECONDS=300
AI_JOB_POLL_SECONDS=1

# Nearby duplicate detection (issue #25). Threshold is meters; score is 0..1.
DUPLICATE_DISTANCE_THRESHOLD_M=100
DUPLICATE_MIN_SCORE=0.4
DUPLICATE_SAME_CATEGORY_WEIGHT=1.0
DUPLICATE_SIMILAR_CATEGORY_WEIGHT=0.7

# Notification delivery (issues #39 / #183): mock = log-only; real = SES email + SNS SMS.
# Production must use NOTIFICATION_ADAPTER=real and SES_FROM_EMAIL (verified SES identity).
NOTIFICATION_ADAPTER=mock
# SES_FROM_EMAIL=noreply@your-verified-domain.example
# SES_CONFIGURATION_SET=
# SNS_SMS_SENDER_ID=
# NOTIFICATION_ALLOW_SMS_ONLY_REAL=true
# Default sandbox is on for local/test/development (allowlists only). Production usually false.
# NOTIFICATION_SANDBOX=true
# NOTIFICATION_ALLOWLIST_EMAILS=you@example.com
# NOTIFICATION_ALLOWLIST_PHONES=+96170123456
# NOTIFICATION_DESTINATION_RATE_LIMIT=10
# NOTIFICATION_DESTINATION_RATE_WINDOW_SECONDS=60

# Unsafe local-only OTP helper (never enable in staging/production).
# When true in local/development/test, prints OTP codes to process stdout so the
# mobile OTP flow can be completed without SMS. Codes are never written via the
# logging framework. Prefer peek_dev_otp_code in automated tests.
# OTP_DEV_PLAINTEXT_STDOUT=false

# Shared API rate limiting (issues #146 / #186).
# Enable TRUST_X_FORWARDED_FOR only behind a trusted proxy/gateway that overwrites client XFF.
TRUST_X_FORWARDED_FOR=false
# Defaults shown; override per environment. DynamoDB shares counters across instances.
RATE_LIMIT_TICKET_SUBMIT_LIMIT=20
RATE_LIMIT_TICKET_SUBMIT_WINDOW_SECONDS=60
RATE_LIMIT_TICKET_TRACK_LIMIT=60
RATE_LIMIT_TICKET_TRACK_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_LIMIT=10
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_LOCATION_VALIDATE_LIMIT=30
RATE_LIMIT_LOCATION_VALIDATE_WINDOW_SECONDS=60
RATE_LIMIT_STAFF_LOGIN_LIMIT=10
RATE_LIMIT_STAFF_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_STAFF_ASSISTANT_LIMIT=30
RATE_LIMIT_STAFF_ASSISTANT_WINDOW_SECONDS=60
RATE_LIMIT_STAFF_SEARCH_LIMIT=40
RATE_LIMIT_STAFF_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_CITIZEN_OTP_REQUEST_LIMIT=5
RATE_LIMIT_CITIZEN_OTP_REQUEST_WINDOW_SECONDS=300
RATE_LIMIT_CITIZEN_OTP_VERIFY_LIMIT=10
RATE_LIMIT_CITIZEN_OTP_VERIFY_WINDOW_SECONDS=300
# Optional smoke tests: send header X-BaladiGuard-Smoke-Token (still rate-limited).
# RATE_LIMIT_SMOKE_BYPASS_TOKEN=
# RATE_LIMIT_SMOKE_LIMIT=1000

# Amazon Location Service place index for geocoding (issue #24).
# Leave empty to use the curated local Beirut place index for CI/local development.
# Production requires a real place index name.
LOCATION_PLACE_INDEX_NAME=

# Optional manual classification eval (not used by CI).
# Image binaries stay outside the repo; the manifest only stores refs.
# Defaults: bucket=AWS_S3_BUCKET, prefix=classification-eval/
CLASSIFICATION_EVAL_S3_PREFIX=classification-eval/
CLASSIFICATION_EVAL_S3_BUCKET=
# Optional HTTPS base if imageRef values are served over HTTP instead of S3:
# CLASSIFICATION_EVAL_IMAGE_BASE_URL=https://example.com/eval-images/

OPENAI_API_KEY=

# Citizen app base URL for SMS/email deep links (issue #257).
# Local/dev/test may omit this (defaults to http://localhost:8081).
# Staging and production MUST set an explicit https URL — no silent localhost fallback.
# CITIZEN_APP_BASE_URL=https://app.baladiguard.example
CITIZEN_APP_BASE_URL=

# WhatsApp Cloud API report channel (issue #296). Keep disabled until Meta credentials exist.
# Local/tests: WHATSAPP_ENABLED=true with WHATSAPP_PROVIDER=mock and placeholder secrets.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_GRAPH_API_VERSION=v21.0
# WHATSAPP_CONVERSATION_TTL_HOURS=24
# WHATSAPP_DEDUP_TTL_SECONDS=86400
# WHATSAPP_MAX_WEBHOOK_BYTES=1048576

# Citizen OTP delivery channel (issue #297). Separate from NOTIFICATION_ADAPTER and #296.
# Unset = legacy auto (mock unless NOTIFICATION_ADAPTER=real → sns).
# CITIZEN_OTP_DELIVERY_CHANNEL=mock
# CITIZEN_OTP_DELIVERY_CHANNEL=sns
# CITIZEN_OTP_DELIVERY_CHANNEL=whatsapp
# CITIZEN_OTP_WHATSAPP_PHONE_NUMBER_ID=
# CITIZEN_OTP_WHATSAPP_ACCESS_TOKEN=
# CITIZEN_OTP_WHATSAPP_TEMPLATE_NAME=baladiguard_auth_otp
# CITIZEN_OTP_WHATSAPP_TEMPLATE_LANGUAGE=en
# CITIZEN_OTP_WHATSAPP_GRAPH_API_VERSION=v21.0
# CITIZEN_OTP_WHATSAPP_TEMPLATE_BUTTON_INDEX=0
# CITIZEN_OTP_WHATSAPP_TIMEOUT_SECONDS=15

# Browser CORS allowlist for admin (:5173) and citizen-web (:5174) (issue #263).
# Local/dev/test may omit this (defaults include localhost Vite + Expo origins).
# Staging and production MUST set an explicit comma-separated https allowlist —
# never silently keep localhost defaults.
# CORS_ALLOWED_ORIGINS=https://admin.baladiguard.example,https://citizen.baladiguard.example
CORS_ALLOWED_ORIGINS=

# Citizen web uses an HttpOnly opaque-session cookie. It is Secure in
# staging/production and accepted only from this same CORS allowlist.

# Staff API auth (issue #175). Individual accounts are persisted; shared env login is removed.
# Required (non-placeholder) SECRET_KEY when APP_ENV=production. Never commit real secrets.
SECRET_KEY=
# Bootstrap local/test demo accounts (admin + staff). Keep false in production.
SEED_DEMO_STAFF=true
DEMO_STAFF_PASSWORD=staff-demo-password
# Legacy aliases (optional): STAFF_PASSWORD still maps to DEMO_STAFF_PASSWORD.
# STAFF_USERNAME=staff
# Access token lifetime in seconds (default 12 hours).
STAFF_TOKEN_TTL_SECONDS=43200

LOG_LEVEL=INFO
# text (default, local demos) or json (production / CloudWatch structured logs).
LOG_FORMAT=text
# Deployed build/version label included in structured logs and health payloads.
APP_VERSION=0.1.0
# Emit CloudWatch Embedded Metric Format on stdout (default: on when APP_ENV=production).
# METRICS_EMF=true
# Continuous ReadyProbeSuccess publisher for CloudWatch readiness alarms (#185).
# READINESS_PROBE_PUBLISHER=true
# READINESS_PROBE_INTERVAL_SECONDS=30
# OBSERVABILITY_ENV=production

# -----------------------------------------------------------------------------
# Local Docker override (optional development only)
# -----------------------------------------------------------------------------
# DATABASE_BACKEND=dynamodb
# DYNAMODB_ENDPOINT_URL=http://localhost:8001
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
# AWS_S3_BUCKET=   # still need real S3 credentials/bucket for photo uploads
